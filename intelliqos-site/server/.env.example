# Скопируйте этот файл в .env и заполните реальными значениями.
# Пока переменной нет — соответствующий способ оплаты работает в "тестовом режиме":
# заказ сохраняется в базе, но покупателя никуда не редиректит — вместо этого
# ему обещают, что с ним свяжутся для оформления оплаты.

PORT=3000

# Адрес сайта в проде (для return_url и т.п.)
SITE_URL=https://intelliqos.uz

# Токен для доступа к /api/admin — придумайте длинную случайную строку
ADMIN_TOKEN=

# --- Payme Business ---
# Получаете после регистрации кассы на business.payme.uz / merchant.payme.uz
PAYME_MERCHANT_ID=
PAYME_MERCHANT_LOGIN=
PAYME_MERCHANT_KEY=
# Обычно менять не нужно, оставьте по умолчанию:
PAYME_CHECKOUT_URL=https://checkout.paycom.uz

# --- Click ---
# Получаете после регистрации бизнеса в Click (my.click.uz для бизнеса)
CLICK_MERCHANT_ID=
CLICK_SERVICE_ID=
CLICK_SECRET_KEY=

# --- ИИ-ассистент на сайте ---
# Без ключа ассистент всё равно работает (отвечает по ключевым словам на
# основе каталога продуктов) — это не заглушка, а рабочий, просто менее гибкий
# режим. С ключом — отвечает через Claude API, понимает вопрос своими словами.
# Ключ получаете на platform.claude.com (раздел API / Console).
ANTHROPIC_API_KEY=
# Модель можно не менять — это самая быстрая и дешёвая на момент разработки.
# Актуальный список моделей: platform.claude.com/docs/en/about-claude/models
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
